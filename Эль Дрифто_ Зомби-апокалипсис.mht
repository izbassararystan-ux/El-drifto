@charset "utf-8";

:root { --sun: #ffd21f; --hot: #ff2e63; --ink: #0d0713; box-sizing: border-box; padding-top: env(safe-area-inset-top,0px); padding-bottom: env(safe-area-inset-bottom,0px); }

html, body { height: 100%; margin: 0px; background: var(--ink); color-scheme: dark; font-family: "Russo One", Impact, "Arial Black", sans-serif; overflow: hidden; touch-action: none; user-select: none; }

#wrap { position: relative; height: 100%; max-height: calc(100dvh - env(safe-area-inset-top,0px) - env(safe-area-inset-bottom,0px)); aspect-ratio: 9 / 16; max-width: 100%; margin: 0px auto; }

canvas { width: 100%; height: 100%; display: block; background: rgb(47, 125, 50); filter: saturate(1.28) contrast(1.05); }

[hidden] { display: none !important; }

.ov { position: absolute; inset: 0px; display: flex; flex-direction: column; gap: 12px; align-items: center; justify-content: center; text-align: center; padding: 7%; background: rgba(13, 7, 19, 0.96); color: rgb(255, 255, 255); overflow: hidden; }

h1 { margin: 0px; font-weight: 400; font-size: clamp(30px, 10vw, 50px); line-height: 1; color: var(--sun); text-shadow: 4px 4px 0 var(--hot); }

h2 { margin: 0px; font-weight: 400; font-size: 28px; color: var(--sun); }

.ov p, #info { margin: 0px; font-family: system-ui, sans-serif; font-size: 15px; line-height: 1.4; color: rgb(216, 205, 230); max-width: 32ch; }

#info { color: var(--sun); font-weight: 700; }

button { font-style: inherit; font-variant: inherit; font-weight: inherit; font-stretch: inherit; line-height: inherit; font-family: inherit; font-optical-sizing: inherit; font-size-adjust: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; font-language-override: inherit; font-size: 19px; padding: 12px 28px; border: 0px; border-radius: 10px; background: var(--hot); color: rgb(255, 255, 255); cursor: pointer; min-height: 46px; }

button:focus-visible { outline: 3px solid var(--sun); outline-offset: 3px; }

button:disabled { opacity: 0.45; }

.sm { font-size: 15px; padding: 9px 16px; background: rgb(59, 26, 90); border: 2px solid var(--sun); }

.row { display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; }

#lg { display: grid; grid-template-columns: repeat(5, 1fr); gap: 8px; width: 100%; max-width: 320px; }

#lg button { padding: 8px 0px; font-size: 20px; background: rgb(59, 26, 90); border: 2px solid var(--sun); }

#lg button.cur { background: var(--hot); }

.tabs { display: flex; gap: 6px; flex-wrap: wrap; justify-content: center; }

.tab { font-size: 13px; padding: 8px 10px; min-height: 38px; background: rgb(59, 26, 90); border: 2px solid transparent; }

.tab.on { border-color: var(--sun); background: var(--hot); }

#ui .bar { position: absolute; left: 0px; right: 0px; bottom: 7%; display: flex; justify-content: center; align-items: center; gap: 10px; padding: 0px 10px; }

#ui .bar .sm { font-size: 17px; padding: 14px 16px; min-height: 52px; }

#go { font-size: 24px; padding: 16px 28px; }

.coins { font-family: system-ui, sans-serif; font-weight: 700; color: var(--sun); font-size: 16px; }

.list { overflow-y: auto; max-height: 50%; width: 100%; display: flex; flex-direction: column; gap: 8px; touch-action: pan-y; }

.card { display: flex; justify-content: space-between; align-items: center; gap: 8px; background: rgb(27, 16, 36); border: 2px solid rgb(59, 26, 90); border-radius: 10px; padding: 8px 10px; font-size: 13px; text-align: left; }

.card.eq { border-color: var(--sun); }

.card button { font-size: 13px; padding: 8px 10px; min-height: 36px; white-space: nowrap; }

.card small { display: block; font-family: system-ui, sans-serif; color: rgb(185, 174, 203); font-size: 11px; }

#pz { position: absolute; top: 10px; left: 50%; margin-left: -22px; width: 44px; height: 44px; padding: 0px; font-size: 15px; border-radius: 50%; background: rgba(13, 7, 19, 0.7); border: 2px solid rgb(255, 255, 255); }

#ctl { position: absolute; left: 0px; right: 0px; bottom: 8px; display: flex; justify-content: space-between; padding: 0px 8px; pointer-events: none; }

#ctl div { display: flex; gap: 8px; }

.cbtn { pointer-events: auto; width: 58px; height: 58px; padding: 0px; border-radius: 50%; font-size: 20px; background: rgba(13, 7, 19, 0.55); border: 2px solid rgba(255, 255, 255, 0.7); touch-action: none; }

.cbtn.t { font-size: 11px; }
